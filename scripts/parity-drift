#!/usr/bin/env python3
"""Report newer upstream changes to extracted origin paths; never execute upstream code."""
import argparse
import json
from pathlib import Path
import re
import subprocess

ROOT = Path(__file__).resolve().parent.parent


def inventory(provenance):
    text = provenance.read_text()
    baseline = re.search(r'^# Commit: ([0-9a-f]{40})$', text, re.MULTILINE)
    if baseline is None:
        raise ValueError('missing extraction commit')
    ports = re.findall(r'^# Port: ([0-9a-f]{40})$', text, re.MULTILINE)
    paths = [line.split('\t')[0] for line in text.splitlines() if line.startswith('scripts/')]
    if not paths:
        raise ValueError('missing mapped script paths')
    paths += ['crates/fractal-kernel/src/evidence', 'crates/fractal-kernel/src/cli_output.rs',
              'crates/fractal/tests/git_evidence.rs']
    # Include committed fixture origins as well as the moving script inventory.
    fixture = provenance.parent.parent / 'tests/fixtures/fractal/PROVENANCE'
    if fixture.exists():
        paths += [line.split('\t')[0] for line in fixture.read_text().splitlines()
                  if '\t' in line and not line.startswith('original_path\t')]
    return ports[-1] if ports else baseline[1], sorted(set(paths))


def report(repo, provenance, ref):
    baseline, paths = inventory(provenance)
    def git(*args):
        return subprocess.check_output(['git', '-C', str(repo), *args], text=True).strip()
    head = git('rev-parse', '--verify', ref + '^{commit}')
    # A stale checkout or rewritten history is an error, not a clean report.
    subprocess.run(['git', '-C', str(repo), 'merge-base', '--is-ancestor', baseline, head], check=True)
    pending = git('log', '--no-merges', '--reverse', '--format=%H %s', f'{baseline}..{head}', '--', *paths)
    return {'ported_through': baseline, 'upstream_head': head,
            'scope': 'newer commits only; older unported work remains in the cutover inventory',
            'commits': pending.splitlines() if pending else []}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--fractal-repo', type=Path, required=True)
    parser.add_argument('--ref', default='HEAD')
    parser.add_argument('--provenance', type=Path, default=ROOT / 'scripts/PROVENANCE')
    parser.add_argument('--report-only', action='store_true')
    args = parser.parse_args()
    result = report(args.fractal_repo, args.provenance, args.ref)
    print(json.dumps(result, indent=2))
    return 0 if args.report_only or not result['commits'] else 1


if __name__ == '__main__':
    raise SystemExit(main())
