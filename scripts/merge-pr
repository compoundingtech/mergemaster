#!/usr/bin/env python3
"""Fail-closed merge-time gate. See AGENTS.md for the approval contract."""
import argparse
import fcntl
import io
import json
from pathlib import Path
import re
import subprocess
import sys
import time
import zipfile

REPO = 'compoundingtech/mergemaster'
SHA = re.compile(r'^[0-9a-f]{40}$')
HUMAN_EMAIL = 'schickling.j@gmail.com'
# GitHub noreply form, with or without the numeric user-ID prefix.
HUMAN_NOREPLY = re.compile(r'^(?:\d+\+)?schickling@users\.noreply\.github\.com$', re.I)
HUMAN_NAME = 'Johannes Schickling'


def command(*args, binary=False, allow_conflict=False):
    result = subprocess.run(args, capture_output=True, timeout=120)
    conflict = allow_conflict and re.match(rb'^HTTP/\S+ 409\b', result.stdout)
    if result.returncode and not conflict:
        raise RuntimeError(f'{" ".join(args)}: {result.stderr.decode(errors="replace").strip()}')
    return result.stdout if binary else result.stdout.decode().strip()


def api(path, *args, allow_conflict=False):
    if allow_conflict:
        response = command('gh', 'api', f'repos/{REPO}/{path}', *args,
                           '--include', allow_conflict=True)
        parts = re.split(r'\r?\n\r?\n', response, maxsplit=1)
        if len(parts) != 2 or not re.match(r'^HTTP/\S+ (200|202|409)\b', parts[0]):
            raise RuntimeError(f'unexpected async merge HTTP response: {response}')
        data = json.loads(parts[1])
        if re.match(r'^HTTP/\S+ 409\b', parts[0]) and (
                not isinstance(data, dict) or data.get('status') != 'pending'):
            raise RuntimeError(f'unexpected async merge conflict response: {data}')
        return data
    return json.loads(command('gh', 'api', f'repos/{REPO}/{path}', *args))


def pages(path, key=None):
    values = []
    for page in range(1, 1001):
        data = api(f'{path}{"&" if "?" in path else "?"}per_page=100&page={page}')
        rows = data[key] if key else data
        values.extend(rows)
        if len(rows) < 100:
            return values
    raise RuntimeError('pagination exceeded 1000 pages')


def git(*args):
    return command('git', *args)


def changed(base, head):
    # Include both sides of renames, so a rename cannot hide an overlap.
    return set(git('diff', '--no-renames', '--name-only', '-z', base, head).split('\0')) - {''}


def pr_changed(base, head):
    return changed(git('merge-base', base, head), head)


def commit_identities(revision):
    rows = git('log', '--format=%H%x1f%an%x1f%ae%x1f%cn%x1f%ce', revision, '--')
    identities = []
    for row in rows.splitlines():
        sha, author_name, author_email, committer_name, committer_email = row.split('\x1f')
        identities.append((sha, author_name, author_email, committer_name, committer_email))
    return identities


def human_authorship_check(commits, label, remedy):
    # Manager decision c5d8b68d: personal human identity must not enter merged history.
    offenders = []
    for sha, author_name, author_email, committer_name, committer_email in commits:
        if any(email.casefold() == HUMAN_EMAIL or HUMAN_NOREPLY.fullmatch(email)
               for email in (author_email, committer_email)):
            offenders.append(sha)
        elif HUMAN_NAME in (author_name, committer_name):
            offenders.append(sha)
    if offenders:
        raise RuntimeError(
            f'{label}: personal authorship by {HUMAN_NAME} <{HUMAN_EMAIL}> in {offenders}; {remedy}')
    return f'no personal authorship in {label}'


def parents(commit):
    return git('show', '-s', '--format=%P', commit).split()


def merge_tree(base, head, merge):
    expected = git('merge-tree', '--write-tree', base, head)
    actual = git('rev-parse', f'{merge}^{{tree}}')
    if expected != actual:
        raise RuntimeError(f'merge tree {actual} differs from local merge-tree {expected}')
    return actual


ACTOR = 'agent/compoundingtech/mergemaster'


def mailbox():
    rows = {}
    for archived in (False, True):
        args = ['st', 'conversations', 'ls', ACTOR, '--as', ACTOR, '--json', '--daemon-wait', '0']
        if archived:
            args.append('--archive')
        data = json.loads(command(*args))
        if not isinstance(data, list):
            raise RuntimeError('Fractal mailbox must return a complete message array')
        for row in data:
            if not isinstance(row, dict) or not isinstance(row.get('created_index'), int):
                raise RuntimeError('unreadable Fractal message envelope')
            if row.get('to') != ACTOR:
                raise RuntimeError('mailbox returned a message for another recipient')
            rows[row['subject']] = row
    return list(rows.values())


def verdicts(rows, pr, head):
    latest = {}
    for row in sorted(rows, key=lambda row: row['created_index']):
        sender = row['from']
        if not isinstance(sender, str) or not sender.startswith('agent/'):
            continue
        body = row['content']
        title = row.get('title') or ''
        if not isinstance(body, str) or not isinstance(title, str):
            raise RuntimeError('unreadable Fractal message content')
        formal = re.match(rf'^(?:Re: )*(?:SOURCE )?(GO|NO-GO) {REPO}#{pr}(?=$|\s|:)', title)
        if not formal:
            continue
        heads = re.findall(r'(?<![0-9a-f])[0-9a-f]{40}(?![0-9a-f])', body)
        if not heads:
            continue
        latest[sender] = (formal[1] == 'NO-GO', head in heads, row['subject'])
    return latest


def approval(ref, latest, messages, pr, head):
    if not re.fullmatch(r'message/[0-9a-f]{16}', ref):
        raise RuntimeError('GO ref must be a Fractal message/ID with a Fractal message sender (same-uid asserted identity); GitHub comments are informational only')
    matches = [row for row in messages if row['subject'] == ref]
    if len(matches) != 1:
        raise RuntimeError(f'{ref}: absent or ambiguous in read-only current/archive listings')
    row = matches[0]
    if row.get('subject') != ref or row.get('to') != ACTOR:
        raise RuntimeError('GO message identity or recipient mismatch')
    sender = row['from']
    if sender == ACTOR:
        raise RuntimeError('author verdicts cannot count as independent GOs')
    own = verdicts([row], pr, head).get(sender)
    if own is None or own[0] or not own[1]:
        raise RuntimeError(f'{ref}: referenced message is not an exact-head GO for this PR')
    if sender not in latest or latest[sender][0] or not latest[sender][1]:
        raise RuntimeError(f'{sender}: latest PR verdict is not an exact-head GO')
    return sender


def tested_merge(run_id, pr):
    archive = command('gh', 'api', f'repos/{REPO}/actions/runs/{run_id}/logs', binary=True)
    commits = set()
    with zipfile.ZipFile(io.BytesIO(archive)) as logs:
        for name in logs.namelist():
            text = logs.read(name).decode(errors='replace')
            # Checkout's own log records the commit actually checked out, unlike run.head_sha
            # (which identifies the PR head). Ignore external-repository checkouts.
            for block in text.split('##[group]Getting Git version info'):
                if f'refs/remotes/pull/{pr}/merge' not in block:
                    continue
                match = re.search(r'\[command\].*?git log -1 --format=%H[^\n]*\n[^\n]*?\b([0-9a-f]{40})\b', block)
                if match:
                    commits.add(match[1])
    if len(commits) != 1:
        raise RuntimeError(f'CI checkout logs must identify exactly one tested PR merge commit; found {sorted(commits)}')
    return commits.pop()


def remote_refs(pr):
    refs = git('ls-remote', 'origin', 'refs/heads/main', f'refs/pull/{pr}/head', f'refs/pull/{pr}/merge')
    result = dict(line.split()[::-1] for line in refs.splitlines())
    keys = ['refs/heads/main', f'refs/pull/{pr}/head', f'refs/pull/{pr}/merge']
    if any(key not in result or not SHA.fullmatch(result[key]) for key in keys):
        raise RuntimeError('origin must advertise main, PR head, and PR merge refs')
    return tuple(result[key] for key in keys)


def current_main():
    value = api('git/ref/heads/main')['object']['sha']
    if not SHA.fullmatch(value):
        raise RuntimeError('main ref did not return a full commit SHA')
    return value


def merge_async(pr, head):
    deadline = time.monotonic() + 600
    path = f'pulls/{pr}/merge-async'
    response = api(path, '--method', 'PUT', '-f', f'sha={head}',
                   '-f', 'merge_method=merge', '-f', 'merge_action=direct_merge',
                   allow_conflict=True)
    result_path = None
    while True:
        if not isinstance(response, dict) or not isinstance(response.get('details'), dict):
            raise RuntimeError(f'unreadable async merge response: {response}')
        status, details = response.get('status'), response['details']
        if status == 'merged':
            merged = details.get('sha')
            if not isinstance(merged, str) or not SHA.fullmatch(merged):
                raise RuntimeError(f'async merge did not identify a full merge commit SHA: {response}')
            return merged
        if status != 'pending':
            raise RuntimeError(f'async merge status={status}: {details}')
        if result_path is None:
            if (details.get('expected_head_sha') != head
                    or details.get('merge_method') != 'merge'
                    or details.get('merge_action') != 'direct_merge'):
                raise RuntimeError(f'async merge pending request does not match approved head/method/action: {details}')
            uuid = details.get('uuid')
            if not isinstance(uuid, str) or not re.fullmatch(r'[0-9a-fA-F-]{36}', uuid):
                raise RuntimeError(f'async merge pending request has invalid uuid: {details}')
            result_path = f'{path}/{uuid}'
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise RuntimeError(f'async merge deadline exceeded (600 seconds); inspect {result_path}; merge may still complete')
        time.sleep(min(3, remaining))
        if time.monotonic() >= deadline:
            raise RuntimeError(f'async merge deadline exceeded (600 seconds); inspect {result_path}; merge may still complete')
        response = api(result_path)


def verify_merged(pr, base, head, expected_tree, merged):
    actual_parents, actual_tree = [], 'unknown'
    try:
        reported = api(f'pulls/{pr}')['merge_commit_sha']
        if reported != merged:
            raise RuntimeError(f'GitHub PR merge commit {reported} differs from async merge commit {merged}')
        git('fetch', '--no-tags', 'origin', merged)
        actual_parents = parents(merged)
        actual_tree = git('rev-parse', f'{merged}^{{tree}}')
        if actual_parents != [base, head] or actual_tree != expected_tree:
            raise RuntimeError('merged parents/tree differ from validated merge')
        human_authorship_check(
            commit_identities(f'{merged}^!'), 'HUMAN AUTHORSHIP IN NEW MAIN MERGE COMMIT',
            'post on COORD')
    except (RuntimeError, KeyError, TypeError, ValueError, OSError, subprocess.TimeoutExpired) as error:
        revert = merged if isinstance(merged, str) and SHA.fullmatch(merged) else '<merge-commit-sha>'
        raise RuntimeError(
            f'POST-MERGE MISMATCH: revert or fresh CI required; merge={merged} '
            f'validated_base={base} approved_head={head} actual_parents={actual_parents} '
            f'validated_tree={expected_tree} actual_tree={actual_tree}; {error}; '
            f'suggested: git revert -m 1 {revert}') from error
    return f'merge={merged} parents={actual_parents} tree={actual_tree}'


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Reviewer messages:
  Send to agent/compoundingtech/mergemaster with subject
  GO compoundingtech/mergemaster#N or NO-GO compoundingtech/mergemaster#N.
  Put the full 40-hex head SHA in the content. GitHub comments are informational:
  agents share a GitHub login. Fractal message sender (same-uid asserted identity)
  is not verified by the server: this gate assumes cooperative agents on
  these hosts. It prevents mistakes, not a malicious same-uid agent.

Verdict details:
  Read current and archived mailbox listings without marking or consuming mail.
  Named GO references must be present in those listings; absent references refuse.
  Each independent agent's latest verdict uses created_index.
  Only subjects starting GO compoundingtech/mergemaster#N or
  NO-GO compoundingtech/mergemaster#N count. Re: and SOURCE prefixes are allowed.
  Content must contain a full 40-hex head SHA; abbreviated SHAs do not count.
  Casual GO/NO-GO words in content never create or change a verdict.
  Any latest NO-GO blocks until that same reviewer posts a later GO.
  Authors withdraw by sending a NO-GO message to themselves; it also blocks.
  Author GOs can clear their withdrawal but never count as independent approval.
  Older-head GOs neither count nor block. A named GO must be at the current head
  and its sender must still have a latest current-head GO.

Mechanical checks:
  Compute sensitive paths from base...head, never from a job in the PR's workflow.
  Inspect all exact-head check-runs, including previous attempts.
  Require the latest successful ci.yml PR run and successful GitHub-hosted jobs.
  Every workflow run at the exact head needs a rerun reason for attempt > 1.
  Derive the tested merge from checkout logs: first parent is CI base, second is
  approved head. Verify the tested tree against local merge-tree at that CI base.
  Intersect changed(CI base, main) with PR changes from CI base...approved head.
  Require open, non-draft, mergeable against main, exact head, merge-ref parents
  (main, head), and tree equality with local git merge-tree --write-tree.
  Recheck refs, verdicts, and readiness before PUT pulls/N/merge-async with
  sha=HEAD, merge_method=merge, merge_action=direct_merge (no rule bypass).
  Requiring base=main excludes open downstack PRs: their branches would be the base.
  Poll completion every 3 seconds for at most 10 minutes; only merged is accepted.
  Any unreadable or uncomputable check refuses merging.
  Serialize local runs with an exclusive flock in the Git common directory.
  Re-read main immediately before merging, then fetch the resulting merge commit
  and verify its first parent and tree against the validated base and merge-tree.
  Another writer can still merge between the final main read and the API call;
  post-merge verification catches that window and reports a revert command.
  Only Mergemaster-authored PRs are supported; --author-agent is an explicit
  author assertion, since the shared GitHub login cannot distinguish agents.

Run from a trusted base checkout, not the PR's copy. Use the agent gh config
for read-only runs. Dry runs fetch Git objects locally but never write GitHub.
Tests: python3 tests/test-merge-pr.py
""")
    parser.add_argument('pr', type=int, help='PR number in compoundingtech/mergemaster')
    parser.add_argument('--author-agent', required=True, help='must be agent/compoundingtech/mergemaster; other author agents require manual review')
    parser.add_argument('--go-head', required=True, help='full 40-hex approved head SHA')
    parser.add_argument('--go-ref', required=True, help='message/ID naming the first GO; Fractal message sender (same-uid asserted identity)')
    parser.add_argument('--second-go-ref', help='distinct current-head reviewer GO; required for .github/ or iac/ changes')
    parser.add_argument('--rerun-reason', help='explicit reason required when the CI run attempt is greater than 1')
    parser.add_argument('--dry-run', action='store_true', help='report PASS/FAIL evidence without merging; exit nonzero on refusal')
    args = parser.parse_args(argv)
    try:
        common = Path(git('rev-parse', '--git-common-dir'))
        with (common / 'merge-pr.lock').open('a') as lock:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
            return run_gate(args)
    except (RuntimeError, ValueError, OSError, subprocess.TimeoutExpired) as error:
        print(f'FAIL merge-pr: {error}', file=sys.stderr)
        return 1


def run_gate(args):
    results = []
    def check(name, action):
        try:
            value = action()
            evidence = value.get('html_url', 'GitHub API response loaded') if isinstance(value, dict) else str(value)
            if name == 'message-mailbox':
                evidence = f'{len(value)} current/archive messages loaded; Fractal message sender (same-uid asserted identity)'
            elif name == 'latest-verdicts':
                evidence = str(value)
            results.append((True, name, evidence))
            return value
        except (RuntimeError, KeyError, TypeError, ValueError, OSError, subprocess.TimeoutExpired, zipfile.BadZipFile) as error:
            results.append((False, name, str(error)))
            return None
    def require(condition, evidence):
        if not condition:
            raise RuntimeError(evidence)
        return evidence
    check('author-agent', lambda: require(args.author_agent == ACTOR,
          'PRs by other agents: no verified author binding yet; merge them manually under review'
          if args.author_agent != ACTOR else f'asserted author={ACTOR}; author GOs excluded'))
    pr = check('pull-request', lambda: api(f'pulls/{args.pr}'))
    check('ready', lambda: require(pr is not None and pr['state'] == 'open' and not pr['draft']
                                  and pr['mergeable'] is True and pr['base']['ref'] == 'main',
                                  f'state={pr and pr.get("state")} draft={pr and pr.get("draft")} mergeable={pr and pr.get("mergeable")} base={pr and pr.get("base", {}).get("ref")}'))
    check('exact-head', lambda: require(bool(SHA.fullmatch(args.go_head)) and pr is not None
                                       and pr['head']['sha'] == args.go_head, f'GO head={args.go_head}; PR head={pr and pr["head"]["sha"]}'))
    messages = check('message-mailbox', mailbox)
    latest = check('latest-verdicts', lambda: verdicts(messages, args.pr, args.go_head))
    reviewer = check('source-go', lambda: approval(args.go_ref, latest, messages, args.pr, args.go_head))
    refs = check('remote-refs', lambda: remote_refs(args.pr))
    paths = None
    tree = None
    if refs:
        base, head, merge = refs
        check('fetch-objects', lambda: git('fetch', '--no-tags', 'origin', base, head, merge) or f'fetched {base} {head} {merge}')
        check('merge-parents', lambda: require(head == args.go_head and parents(merge) == [base, head],
                                             f'main={base} head={head} merge={merge} parents={parents(merge)}'))
        tree = check('merge-tree', lambda: merge_tree(base, head, merge))
        paths = check('changed-files', lambda: sorted(pr_changed(base, head)))
    def second_go():
        if paths is None:
            raise RuntimeError('base...head changed files unavailable')
        sensitive = [path for path in paths if path.startswith(('.github/', 'iac/'))]
        if not sensitive:
            return 'no .github/ or iac/ touches in base..head'
        if not args.second_go_ref:
            raise RuntimeError(f'--second-go-ref required for {sensitive}')
        second = approval(args.second_go_ref, latest, messages, args.pr, args.go_head)
        return require(reviewer is not None and second != reviewer, f'second reviewer={second}; first={reviewer}; sensitive={sensitive}')
    check('sensitive-second-go', second_go)
    def binding():
        if latest is None:
            raise RuntimeError('Fractal message sender (same-uid asserted identity) verdicts unavailable')
        blocked = {sender: verdict[2] for sender, verdict in latest.items() if verdict[0]}
        return require(not blocked, f'latest reviewer verdicts={latest}; NO-GOs={blocked}')
    check('binding-verdicts', binding)
    def checks():
        rows = pages(f'commits/{args.go_head}/check-runs?filter=all', 'check_runs')
        evidence = '; '.join(f'{row["name"]}={row["status"]}/{row["conclusion"]} ({row["html_url"]})' for row in rows)
        return require(bool(rows) and all(row['head_sha'] == args.go_head and row['status'] == 'completed'
                                         and row['conclusion'] in ('success', 'skipped') for row in rows), evidence or 'no exact-head check-runs')
    check('exact-head-check-runs', checks)
    def attempts():
        runs = pages(f'actions/runs?head_sha={args.go_head}', 'workflow_runs')
        reruns = []
        for run in runs:
            require(run['head_sha'] == args.go_head and isinstance(run['run_attempt'], int)
                    and run['run_attempt'] >= 1, f'invalid workflow head/attempt: {run}')
            if run['run_attempt'] > 1:
                reruns.append(f'{run["html_url"]} attempt={run["run_attempt"]}')
        return require(bool(runs) and (not reruns or bool(args.rerun_reason and args.rerun_reason.strip())),
                       f'{len(runs)} exact-head workflow runs; reruns={reruns}; reason={args.rerun_reason or "not provided"}')
    check('workflow-attempts', attempts)
    def ci():
        runs = pages(f'actions/workflows/ci.yml/runs?head_sha={args.go_head}&event=pull_request', 'workflow_runs')
        runs = [run for run in runs if run['head_sha'] == args.go_head and any(p['number'] == args.pr for p in run['pull_requests'])]
        if not runs:
            raise RuntimeError('no hosted CI pull_request run at exact head')
        run = max(runs, key=lambda row: row['id'])
        require(run['status'] == 'completed' and run['conclusion'] == 'success', f'{run["html_url"]} {run["status"]}/{run["conclusion"]}')
        jobs = pages(f'actions/runs/{run["id"]}/attempts/{run["run_attempt"]}/jobs', 'jobs')
        executed = [job for job in jobs if job['conclusion'] != 'skipped']
        require(bool(executed) and all(job['runner_group_name'] == 'GitHub Actions'
                                      and job['status'] == 'completed' and job['conclusion'] == 'success'
                                      for job in executed), 'CI must have successful GitHub-hosted jobs')
        return run
    run = check('hosted-ci', ci)
    def overlap():
        if run is None or refs is None or paths is None:
            raise RuntimeError('successful CI, refs, and changed files required')
        tested = tested_merge(run['id'], args.pr)
        git('fetch', '--no-tags', 'origin', tested)
        tested_parents = parents(tested)
        require(len(tested_parents) == 2 and tested_parents[1] == args.go_head,
                f'CI tested={tested} parents={tested_parents}; expected second parent={args.go_head}')
        ci_base = tested_parents[0]
        tested_tree = merge_tree(ci_base, args.go_head, tested)
        overlap_paths = sorted(changed(ci_base, refs[0]) & pr_changed(ci_base, args.go_head))
        return require(not overlap_paths, f'CI tested={tested} tree={tested_tree} CI base(first parent)={ci_base} main={refs[0]} overlap={overlap_paths}; rerun reason={args.rerun_reason or "attempt 1"}')
    check('ci-base-overlap', overlap)
    def stable():
        current = api(f'pulls/{args.pr}')
        require(verdicts(mailbox(), args.pr, args.go_head) == latest, 'Fractal message sender (same-uid asserted identity) verdicts unchanged during checks')
        return require(refs is not None and remote_refs(args.pr) == refs and current['head']['sha'] == args.go_head
                       and current['state'] == 'open' and not current['draft'] and current['mergeable'] is True
                       and current['base']['ref'] == 'main',
                       'main/head/merge refs and PR readiness unchanged during checks')
    check('final-snapshot', stable)
    def human_authorship():
        if refs is None:
            raise RuntimeError('remote refs required for the authorship check')
        return human_authorship_check(
            commit_identities(f'{refs[0]}..{args.go_head}'), f'origin/main..HEAD_SHA {refs[0]}..{args.go_head}',
            're-author on a new signed branch with the agent identity, or land by squash, as Manager decides')
    check('no-human-authorship', human_authorship)
    for passed, name, evidence in sorted(results, key=lambda row: row[0]):
        print(f'{"PASS" if passed else "FAIL"} {name}: {evidence}')
    failures = sum(not passed for passed, _, _ in results)
    print(f'{"DRY RUN" if args.dry_run else "GATE"}: {len(results) - failures} PASS, {failures} FAIL; PR #{args.pr} head={args.go_head}')
    if failures:
        return 1
    if not args.dry_run:
        if current_main() != base:
            raise RuntimeError(f'main changed immediately before merge; validated base={base}')
        merged = merge_async(args.pr, args.go_head)
        print(f'PASS post-merge: {verify_merged(args.pr, base, head, tree, merged)}')
    return 0


if __name__ == '__main__':
    sys.exit(main())
