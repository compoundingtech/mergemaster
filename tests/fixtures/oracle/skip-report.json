  "recipe": "Independent pinned Python main(now=...) with fixed UTC clock; strict gh/git executable shims; raw stdout/stderr; only canonical call ordering and temporary-root placeholders. Native CLI uses --now. Repeated cases reuse the same cache and assert no second log downloads.",
  "shim": "import json, os, sys\nfrom pathlib import Path\napi = json.loads(Path(os.environ['FLIP_SKIP_API']).read_text())\nargs = sys.argv[1:]\ntool = Path(sys.argv[0]).name\nif tool == 'git' and args[:1] == ['-C']: args = args[2:]\nwith open(os.environ['FLIP_SKIP_CALLS'], 'a') as out: out.write(json.dumps([tool, *args]) + '\\n')\nif tool == 'git':\n    if args[0] == 'fetch':\n        if api.get('git_error'):\n            sys.stderr.write(api['git_error']); sys.exit(1)\n    elif args[:2] == ['remote', 'get-url']:\n        sys.exit(1)\n    elif args[0] == 'ls-tree':\n        if api.get('fractal'): sys.stdout.write('100644 blob fixture\\t' + args[-1] + '\\0')\n    elif args[0] == 'show':\n        path = args[-1].split(':', 1)[1]\n        if path.endswith('evidence-skip-policy.json'): print(json.dumps({'checks': api['policy']}))\n        elif path.endswith('required-lanes.json'): print(json.dumps({'lanes': api.get('lanes', {})}))\n        elif path == '.github/workflows/fleet.yml': sys.stdout.write(api['workflow'])\n        else: raise AssertionError(args)\n    else: raise AssertionError(args)\nelse:\n    assert tool == 'gh' and args[0] == 'api', args\n    path = next(arg for arg in args[1:] if arg.startswith('repos/'))\n    error = api.get('gh_error') or api.get('errors', {}).get(path)\n    if error: sys.stderr.write(error); sys.exit(1)\n    if '/workflows/' in path:\n        key = path.split('/workflows/')[1].split('/')[0]\n        runs = api.get('release_runs' if key == 'release-fractal.yml' else 'runs', [])\n        print(json.dumps({'workflow_runs': runs, 'total_count': len(runs)}))\n    elif path.endswith('/logs'):\n        job = path.split('/jobs/')[1].split('/')[0]\n        sys.stdout.write(api['logs'][job])\n    elif '/jobs?' in path:\n        run = path.split('/runs/')[1].split('/')[0]\n        print(json.dumps([{'jobs': api.get('jobs', {}).get(run, [])}]))\n    elif '/files?' in path:\n        print(json.dumps([[{'filename': name} for name in api.get('files', [])]]))\n    elif '/commits/' in path and path.endswith('/pulls'):\n        print(json.dumps([{'number': 17}]))\n    else: raise AssertionError(args)\n",
  "launcher": "import datetime, importlib.machinery, importlib.util, pathlib, sys\npath, now, root, *args = sys.argv[1:]\nloader = importlib.machinery.SourceFileLoader('frozen_oracle', path)\nmodule = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))\nloader.exec_module(module)\nsys.exit(module.main(args, now=datetime.datetime.fromisoformat(now.replace('Z', '+00:00')), root=pathlib.Path(root)))\n",
